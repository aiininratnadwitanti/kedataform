# ===== Server =====
PORT=4000
APP_URL="http://localhost:4000"

# ===== MySQL (Laragon lokal) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=formcraft_studio
# Produksi (mis. TiDB Cloud Serverless): set DB_SSL=true, DB_SKIP_CREATE=true
DB_SSL=false
DB_SKIP_CREATE=false
# Batas koneksi pool (serverless Vercel disarankan 2-5)
DB_CONN_LIMIT=
# Opsional TLS: verifikasi sertifikat (default true) & sertifikat CA (PEM, boleh pakai \n literal)
DB_SSL_REJECT_UNAUTHORIZED=
DB_SSL_CA=

# Paksa cookie sesi secure (true/false). Kosongkan agar otomatis dari APP_URL (https -> true).
COOKIE_SECURE=

# ===== Google OAuth 2.0 (Google Cloud Console) =====
# Cara membuat: https://console.cloud.google.com -> APIs & Services -> Credentials
# Authorized JavaScript origin : http://localhost:4000
# Authorized redirect URI      : http://localhost:4000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/auth/google/callback"

# ===== Admin (comma-separated email Google) =====
ADMIN_EMAILS=

# ===== Email Undangan Kolaborasi (Gmail SMTP) =====
# Aktifkan 2-Step Verification, lalu buat App Password 16 karakter:
# https://myaccount.google.com/apppasswords
# Tempel App Password TANPA spasi. Jika kosong, email otomatis dinonaktifkan
# dan undangan hanya muncul di Pusat Notifikasi aplikasi.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="alamat@gmail.com"
SMTP_PASS=""
MAIL_FROM="KedataForm <alamat@gmail.com>"

# ===== Gemini AI (opsional, untuk generator form AI) =====
# AI Studio / Google AI Studio API key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ===== Deploy Vercel (produksi) =====
# APP_URL dan GOOGLE_REDIRECT_URI WAJIB memakai domain Vercel (https), contoh:
#   APP_URL="https://kedataform.vercel.app"
#   GOOGLE_REDIRECT_URI="https://kedataform.vercel.app/api/v1/auth/google/callback"
# Tambahkan origin + redirect URI tsb di Google Cloud Console (Credentials).

# ===== Midtrans (Payment Gateway) =====
# Ambil di https://dashboard.midtrans.com -> Settings -> Access Keys
# Sandbox: https://dashboard.sandbox.midtrans.com
# Notification URL (webhook): http://<domain>/api/v1/billing/midtrans/notification
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
